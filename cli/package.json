{
  "name": "textusm.cli",
  "description": "Generate a User Story Mapping from indented text.",
  "version": "0.14.9",
  "author": "Takahiro Sato",
  "bin": {
    "textusm": "dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/harehare/textusm/issues"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "html-escaper": "^3.0.3",
    "mustache": "^4.2.0",
    "puppeteer": "^25.16.0",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@types/html-escaper": "^3.0.2",
    "@types/mustache": "^4.2.5",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/harehare/textusm",
  "keywords": [
    "cli",
    "user-story-map",
    "user-story-mapping",
    "usm",
    "svg",
    "png",
    "pdf"
  ],
  "files": [
    "dist",
    "js"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harehare/textusm.git"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": ["bufferutil", "esbuild", "puppeteer", "utf-8-validate"]
  },
  "scripts": {
    "build": "tsup index.ts js/textusm.js",
    "prepublish": "tsc index.ts --outDir dist",
    "prebuild": "cd ../extension/lib && pnpm build && cp dist/index.js ../../cli/js/textusm.js"
  },
  "tsup": {
    "entry": [
      "index.ts",
      "js/textusm.js"
    ],
    "splitting": false,
    "clean": true
  }
}
