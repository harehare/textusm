{
  "name": "textusm",
  "version": "0.14.8",
  "description": "Generate a User Story Map from indented text.",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "watch": "webpack --mode development --watch",
    "build": "NODE_ENV=production webpack --mode production",
    "prepublishOnly": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint src/",
    "format": "oxfmt src/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harehare/textusm/tree/master/extension/lib"
  },
  "bugs": {
    "url": "https://github.com/harehare/textusm/issues"
  },
  "keywords": [
    "user-story-map",
    "usm",
    "svg",
    "png",
    "pdf",
    "user-story-mapping",
    "mindmap",
    "business-model-canvas"
  ],
  "author": "harehare",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "clean-webpack-plugin": "^4.0.0",
    "module": "^1.2.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  }
}
